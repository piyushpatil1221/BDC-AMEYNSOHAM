          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        },
        {
          "refId": "C",
          "expr": "vector(0.05)",
          "legendFormat": "budget",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
